# /opt/realdosing-pricing/env  (EXAMPLE -- copy to that path, fill in real values,
# chmod 600, never commit the real file)
#
# Read by both realdosing-pricing-intake.service and
# realdosing-pricing-worker.service via EnvironmentFile=.

# Required by worker.py: Anthropic Messages API key used to call
# research_price() (the web_search + pricing step).
# Create/manage at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...your-key-here...

# Required by worker.py for git push after pricing a product.
# Use a GitHub fine-grained PAT with "Contents: Read and write" scope on
# the supplement-price-app repo. Format:
#   https://<github-username>:<your-pat>@github.com/alpha-tronex/supplement-price-app.git
# Create at: https://github.com/settings/personal-access-tokens/new
PRICE_REQUEST_GIT_PUSH_URL=https://alpha-tronex:ghp_...your-pat...@github.com/alpha-tronex/supplement-price-app.git

# Required by worker.py to send "your product is priced" emails via Resend.
# Sign up at https://resend.com, verify dosinghub.com as a sending domain
# (add the DNS TXT record Resend gives you to Cloudflare), then create an
# API key at https://resend.com/api-keys.
# Without this key, pricing still works -- emails are simply not sent.
RESEND_API_KEY=re_...your-key-here...

# Optional overrides (defaults shown, only set if you need to change them):
# PRICE_REQUEST_QUEUE_PATH=/opt/realdosing-pricing/queue.jsonl
# PRICE_REQUEST_STATE_PATH=/opt/realdosing-pricing/worker_state.json
# PRICE_REQUEST_WORKER_AUDIT_LOG_PATH=/opt/realdosing-pricing/worker_audit.jsonl
# PRICE_INDEX_PATH=/opt/realdosing/supplement-price-app/app/public/data/price-index.json
# AUTO_PRICE_MODEL=claude-sonnet-4-5-20250929
